# ─────────────────────────────────────────────────────────────
# Mars Space LMS — backend environment
# Copy to `.env` and adjust. Every variable is validated by Joi
# on boot (src/core/config/validation.schema.ts); the app refuses
# to start when the configuration is invalid.
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
# development | production | test
NODE_ENV=development
# HTTP port the API listens on
PORT=4000
# Global route prefix — every route is mounted under it
API_PREFIX=api/v1
# Comma-separated list of allowed browser origins (CORS whitelist)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Serve Swagger UI at /api/docs. Defaults to on outside production and OFF
# in production: the docs enumerate every admin route and payload, so a
# public deployment has to opt in deliberately.
SWAGGER_ENABLED=true

# ── Database ─────────────────────────────────────────────────
# PostgreSQL 16 connection string used by Prisma
DATABASE_URL=postgresql://mars:mars@localhost:5432/mars_space?schema=public

# ── Authentication ───────────────────────────────────────────
# Secret signing the short-lived access token (min 16 chars)
# In production a secret must be at least 32 characters AND must not be one
# of the placeholders committed to this repo — boot fails otherwise.
# Generate one with:  openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access
# Access token lifetime (vercel/ms format: 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
# Secret signing the refresh token — MUST differ from the access secret
JWT_REFRESH_SECRET=change_me_refresh
# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=7d

# ── File storage ─────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
# Directory used by the `local` driver (relative to the app root)
STORAGE_LOCAL_PATH=./uploads
# Public base URL that uploaded files are served from
STORAGE_PUBLIC_URL=http://localhost:4000/uploads
# Max accepted upload size in bytes (default 5 MB)
STORAGE_MAX_FILE_SIZE=5242880
# S3-compatible settings — required only when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Notifications ────────────────────────────────────────────
# Telegram bot that receives new-lead alerts. Leave empty to disable:
# the notifier then logs a warning and never breaks the request.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Rate limiting ────────────────────────────────────────────
# Global window in seconds and the request budget inside it (per IP)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Seeding ──────────────────────────────────────────────────
# Credentials of the SUPER_ADMIN created by `pnpm db:seed`.
# In production the seeder REFUSES these placeholders and demands 12+ chars.
# CHANGE THE PASSWORD AFTER THE FIRST LOGIN.
SEED_ADMIN_EMAIL=admin@marsspace.uz
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_MANAGER_EMAIL=manager@marsspace.uz
SEED_MANAGER_PASSWORD=ChangeMe123!

# Seed fabricated students, leads, posts and testimonials alongside the
# catalogue. Defaults to on outside production, off in production.
# Never set this to true against a live database.
SEED_DEMO=true
